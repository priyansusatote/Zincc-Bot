{
  "openapi": "3.0.3",
  "info": {
    "title": "Zincc browser API",
    "version": "1.0.0"
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/workspaces/{workspaceId}/conversations": {
      "get": {
        "operationId": "conversations",
        "parameters": [
          {
            "in": "path",
            "name": "workspaceId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationDirectory"
                }
              }
            }
          },
          "404": {
            "description": "Resource unavailable"
          }
        }
      }
    },
    "/api/workspaces/{workspaceId}/conversations/{id}": {
      "get": {
        "operationId": "snapshot",
        "parameters": [
          {
            "in": "path",
            "name": "workspaceId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationSnapshot"
                }
              }
            }
          },
          "404": {
            "description": "Resource unavailable"
          }
        }
      }
    },
    "/api/workspaces/{workspaceId}/conversations/{id}/events": {
      "get": {
        "operationId": "replay",
        "parameters": [
          {
            "in": "path",
            "name": "workspaceId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "after",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "in": "header",
            "name": "Last-Event-ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded SSE replay; turn.v1 data contains a ConversationEvent",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Resource unavailable"
          },
          "409": {
            "description": "Invalid cursor"
          },
          "410": {
            "description": "Cursor expired; fetch snapshot"
          }
        }
      }
    },
    "/api/workspaces/{workspaceId}/conversations/{id}/turns": {
      "post": {
        "operationId": "sendTurn",
        "parameters": [
          {
            "in": "path",
            "name": "workspaceId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnCommand"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Command processed or exact duplicate"
          },
          "400": {
            "description": "Invalid command or route"
          },
          "403": {
            "description": "Invalid CSRF token"
          },
          "404": {
            "description": "Resource unavailable"
          },
          "409": {
            "description": "Conflicting revision, ID or running turn"
          },
          "422": {
            "description": "Conversation full"
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "operationId": "readSession",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required"
          }
        }
      }
    },
    "/api/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Membership"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sign in required"
          }
        }
      }
    },
    "/api/workspaces/{workspaceId}": {
      "get": {
        "operationId": "readWorkspace",
        "parameters": [
          {
            "in": "path",
            "name": "workspaceId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Membership"
                }
              }
            }
          },
          "401": {
            "description": "Sign in required"
          },
          "404": {
            "description": "Workspace unavailable"
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "operationId": "logout",
        "description": "Send the CSRF header name and value from the current session.",
        "responses": {
          "204": {
            "description": "Session ended"
          },
          "403": {
            "description": "Invalid CSRF token"
          }
        }
      }
    },
    "/api/workspaces/{workspaceId}/research": {
      "post": {
        "operationId": "research",
        "parameters": [
          {
            "in": "path",
            "name": "workspaceId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded cited passages and coverage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchAnswer"
                }
              }
            }
          },
          "403": {
            "description": "Research disabled or invalid CSRF token"
          },
          "404": {
            "description": "Workspace unavailable"
          },
          "429": {
            "description": "Busy"
          },
          "502": {
            "description": "Search unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ZINCCSESSION"
      }
    },
    "schemas": {
      "ThreadInfo": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "ConversationDirectory": {
        "type": "object",
        "required": [
          "threads",
          "routes"
        ],
        "properties": {
          "presets": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "threads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ThreadInfo"
            }
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publicResearch": {
            "type": "boolean"
          }
        }
      },
      "Turn": {
        "type": "object",
        "required": [
          "id",
          "route",
          "question",
          "answer",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "route": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "interrupted"
            ]
          }
        }
      },
      "ConversationSnapshot": {
        "type": "object",
        "required": [
          "revision",
          "turns"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "turns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Turn"
            }
          }
        }
      },
      "TurnCommand": {
        "type": "object",
        "required": [
          "turnId",
          "revision",
          "route",
          "question"
        ],
        "properties": {
          "turnId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "route": {
            "type": "string"
          },
          "question": {
            "type": "string"
          }
        }
      },
      "ConversationEvent": {
        "type": "object",
        "required": [
          "seq",
          "turnId",
          "kind",
          "body",
          "at",
          "route"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "format": "int64"
          },
          "turnId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "started",
              "delta",
              "completed",
              "interrupted"
            ]
          },
          "body": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "route": {
            "type": "string"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "accountLabel",
          "provisioned",
          "csrfHeader",
          "csrfToken"
        ],
        "properties": {
          "accountLabel": {
            "type": "string"
          },
          "provisioned": {
            "type": "boolean"
          },
          "csrfHeader": {
            "type": "string"
          },
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "Membership": {
        "type": "object",
        "required": [
          "workspaceId",
          "workspaceName",
          "role"
        ],
        "properties": {
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "member"
            ]
          }
        }
      },
      "ResearchQuery": {
        "type": "object",
        "required": [
          "query",
          "fresh"
        ],
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 300
          },
          "fresh": {
            "type": "boolean"
          }
        }
      },
      "ResearchAnswer": {
        "type": "object",
        "required": [
          "discovered",
          "attempted",
          "fetched",
          "citations"
        ],
        "properties": {
          "discovered": {
            "type": "integer",
            "minimum": 0
          },
          "attempted": {
            "type": "integer",
            "minimum": 0
          },
          "fetched": {
            "type": "integer",
            "minimum": 0
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResearchEvidence"
            }
          }
        }
      },
      "ResearchEvidence": {
        "type": "object",
        "required": [
          "title",
          "requestedUrl",
          "finalUrl",
          "quote",
          "observedAt",
          "cached"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "requestedUrl": {
            "type": "string",
            "format": "uri"
          },
          "finalUrl": {
            "type": "string",
            "format": "uri"
          },
          "quote": {
            "type": "string"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "cached": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
